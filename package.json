{
  "name": "nearby-pharmacies-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "style": "node scripts/style-check.mjs",
    "style:all": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "test:unit": "vitest run",
    "test:ui": "playwright test",
    "test:ui:install": "playwright install chromium webkit",
    "data:import": "node scripts/data/import.ts",
    "data:addresses": "node scripts/data/import-addresses.ts",
    "data:sync-ios": "node scripts/data/sync-ios.ts",
    "data:verify": "node scripts/data/verify-ios.ts",
    "data:check-fixture": "python3 -I fixtures/ranking/compute_expected.py --check"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "pbf": "5.1.2",
    "polylabel": "2.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
