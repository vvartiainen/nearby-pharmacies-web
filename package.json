    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
